{
  "name": "@krelborn/stylesui",
  "version": "0.8.0",
  "description": "Tree-shakable React 19 component library styled with CSS modules and custom properties, with themes, palettes, light and dark modes, and accessibility tests against WCAG 2.2 AA.",
  "keywords": [
    "accessibility",
    "component-library",
    "css-custom-properties",
    "css-modules",
    "dark-mode",
    "design-system",
    "react",
    "react-components",
    "theming",
    "ui-library",
    "wcag"
  ],
  "homepage": "https://github.com/Krelborn/StylesUI#readme",
  "bugs": {
    "url": "https://github.com/Krelborn/StylesUI/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krelborn/StylesUI.git"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts/playful.css": "./fonts/playful.css"
  },
  "publishConfig": {
    "@krelborn:registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:storybook": "vitest run --project=\"storybook*\"",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "lucide-static": "^1.54.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "packageManager": "pnpm@10.18.3"
}
