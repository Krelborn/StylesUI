{
  "projectId": "1738c3d0-eb31-4def-9023-bded6e28864a",
  "pkg": "@krelborn/stylesui",
  "globalName": "StylesUI",
  "shape": "storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "storybookConfigDir": ".storybook",
  "buildCmd": "pnpm build",
  "tsconfig": ".design-sync/tsconfig.json",
  "extraEntries": ["./.design-sync/global-styles.js"],
  "extraFonts": [
    "node_modules/@fontsource-variable/fredoka/wght.css",
    "node_modules/@fontsource-variable/nunito/wght.css"
  ],
  "guidelinesGlob": "docs/design/*.md",
  "titleMap": {
    "Contrast": null,
    "Themeshowcase": "Theme",
    "Tokens": null,
    "Blogpage": null,
    "Contactform": null,
    "Emptystate": null,
    "Icons": "CloseIcon"
  },
  "overrides": {
    "Button": {
      "cardMode": "column"
    },
    "Popover": {
      "cardMode": "single",
      "primaryStory": "HeldOpen"
    },
    "Center": {
      "cardMode": "column"
    },
    "Grid": {
      "cardMode": "column"
    },
    "Sidebar": {
      "cardMode": "column"
    },
    "Switcher": {
      "cardMode": "column"
    },
    "PageLayout": {
      "cardMode": "single"
    },
    "Theme": {
      "cardMode": "column"
    },
    "TextInput": {
      "cardMode": "column"
    },
    "Tooltip": {
      "cardMode": "single",
      "primaryStory": "Placement"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
